# Cloudflare Pages header rules. Must live in the build output directory.
#
# Filenames are not content-hashed, so cache lifetimes are deliberately
# finite: a rebuilt model would otherwise keep serving stale geometry until
# the TTL expired. index.html always revalidates so a redeploy is picked up
# immediately, and it is the file that references everything else.

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin

# Geometry is the bulk of the payload and changes only on a rebuild.
/models/*
  Cache-Control: public, max-age=604800

# Vendored three.js is pinned to a version and effectively immutable.
/vendor/*
  Cache-Control: public, max-age=604800

# These two MUST revalidate. They are coupled to the DOM in index.html, which
# itself always revalidates, so caching them for any length of time lets a
# returning visitor pair fresh HTML with stale JavaScript. That is exactly how
# removing one button produced "cannot read properties of null" for anyone who
# had visited before. They are ~30 KB combined, so a conditional request
# costing a 304 is a bargain next to a broken page.
/css/*
  Cache-Control: public, max-age=0, must-revalidate

/js/*
  Cache-Control: public, max-age=0, must-revalidate

# Small, and they decide what the viewer loads, so keep them fresh.
/manifest.json
  Cache-Control: public, max-age=3600

/anatomy.json
  Cache-Control: public, max-age=3600

/index.html
  Cache-Control: public, max-age=0, must-revalidate
